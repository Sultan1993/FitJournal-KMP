-- v9 -> v10: workout sessions + per-record workout number.
--
-- The v8->v9 squash (8.sqm) predates the session feature, so the baseline this
-- runs against has no workoutSessions table and no workoutRecords.workoutNumber.
-- This migration and the .sq schema were reworked together (the earlier
-- sessionId / one-session-per-day groundwork that lived in 9.sqm + 10.sqm was
-- never released, so it is replaced outright rather than migrated through — and
-- 10.sqm is deleted). Keep the CREATE TABLE and index shapes byte-for-byte
-- identical to WorkoutSessions.sq, and add the workoutRecords column so a fresh
-- install (Schema.create) and an upgrade land on the same schema —
-- verifyMigrations is off (see CLAUDE.md), so this is hand-verified.

CREATE TABLE workoutSessions (
    uuid TEXT PRIMARY KEY NOT NULL,
    userId TEXT NOT NULL,
    journalId TEXT NOT NULL,
    date TEXT NOT NULL,
    workoutNumber INTEGER NOT NULL,
    startedAt TEXT NOT NULL,
    endedAt TEXT,
    comment TEXT
);

CREATE UNIQUE INDEX idx_workoutSessions_page
ON workoutSessions(userId, journalId, date, workoutNumber);
CREATE INDEX idx_workoutSessions_running
ON workoutSessions(userId) WHERE endedAt IS NULL;

-- DEFAULT 1 backfills every existing record to workout 1 (SQLite requires a
-- default to add a NOT NULL column to a populated table). ADD COLUMN appends at
-- the end, which is why workoutNumber is the last column in WorkoutRecords.sq.
ALTER TABLE workoutRecords ADD COLUMN workoutNumber INTEGER NOT NULL DEFAULT 1;

-- Position is now page-relative (0-based within each workout), so the day-order
-- index gains workoutNumber before position. 8.sqm created the old
-- (…, date DESC, position ASC) form; drop and recreate to match WorkoutRecords.sq.
DROP INDEX idx_workoutRecords_live_journal;
CREATE INDEX idx_workoutRecords_live_journal ON workoutRecords(userId, journalId, date DESC, workoutNumber ASC, position ASC) WHERE deletedAt IS NULL;

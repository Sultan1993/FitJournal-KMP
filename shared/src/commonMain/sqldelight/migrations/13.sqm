-- Backfill partial indexes that exist in the live `.sq` schema source
-- of truth but were never added through any prior migration. Fresh
-- installs always had them via the `CREATE INDEX` in `Notes.sq` and
-- `BodyMeasurements.sq`; upgrade-path users have been doing full-table
-- scans on `getNotes` and `getBodyMeasurements` since FJ 2.0.
--
-- Both indexes match queries that filter `deletedAt IS NULL` and scope
-- by user (and journal for body measurements). Partial-index form keeps
-- them tight: tombstoned rows are excluded, so the on-disk size scales
-- with live rows only.

CREATE INDEX IF NOT EXISTS idx_notes_user_live
ON notes(userId)
WHERE deletedAt IS NULL;

CREATE INDEX IF NOT EXISTS idx_bodyMeasurements_diary_live
ON bodyMeasurements(userId, journalId)
WHERE deletedAt IS NULL;

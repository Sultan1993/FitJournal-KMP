-- Tighten sync-push indices across every sync-target table. Fresh
-- installs pick the new shapes up from the `.sq` files directly.
--
-- Each `idx_X_pending` becomes partial on `pendingUpload = 1`. The old
-- full-column form stored one entry per row regardless of pending
-- state — for a typical user with 0 pending and hundreds of rows
-- per table, that's hundreds of wasted index entries. The partial
-- form scales with the sync-backlog size (typically 0).
--
-- Matches the pattern already in place for notes (migration 15).

DROP INDEX IF EXISTS idx_exercises_pending;
CREATE INDEX IF NOT EXISTS idx_exercises_pending
ON exercises(uuid)
WHERE pendingUpload = 1;

DROP INDEX IF EXISTS idx_workoutRecords_pending;
CREATE INDEX IF NOT EXISTS idx_workoutRecords_pending
ON workoutRecords(uuid)
WHERE pendingUpload = 1;

DROP INDEX IF EXISTS idx_bodyMeasurements_pending;
CREATE INDEX IF NOT EXISTS idx_bodyMeasurements_pending
ON bodyMeasurements(uuid)
WHERE pendingUpload = 1;

DROP INDEX IF EXISTS idx_diaries_pending;
CREATE INDEX IF NOT EXISTS idx_diaries_pending
ON journals(uuid)
WHERE pendingUpload = 1;

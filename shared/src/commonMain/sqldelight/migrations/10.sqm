-- Index consolidation. Drop legacy redundant indices, add hot-path
-- partial index for the canonical (userId, journalId, date DESC, position ASC)
-- read pattern, plus partial indices on notes/bodyMeasurements for their
-- (userId[, journalId]) live reads.

DROP INDEX IF EXISTS idx_workoutRecords_user_date;
DROP INDEX IF EXISTS idx_workoutRecords_diary;

CREATE INDEX IF NOT EXISTS idx_workoutRecords_live_diary
ON workoutRecords(userId, journalId, date DESC, position ASC)
WHERE deletedAt IS NULL;

CREATE INDEX IF NOT EXISTS idx_notes_user_live
ON notes(userId)
WHERE deletedAt IS NULL;

CREATE INDEX IF NOT EXISTS idx_bodyMeasurements_diary_live
ON bodyMeasurements(userId, journalId)
WHERE deletedAt IS NULL;

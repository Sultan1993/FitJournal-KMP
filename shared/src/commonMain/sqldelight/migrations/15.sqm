-- Tighten notes index coverage for upgrade-path users. Fresh installs
-- pick these up directly from `Notes.sq`.
--
-- 1. `idx_notes_pending` becomes partial on `pendingUpload = 1`. The
--    old full-column index stored an entry per row regardless of
--    pending state — for a heavy user with 0 pending and 200 notes,
--    that's 200 wasted index entries. The partial form scales with the
--    sync-backlog size (typically 0).
--
-- 2. New `idx_notes_pinned_live` covers `getPinnedNotes` end-to-end —
--    partial on `isPinned = 1 AND deletedAt IS NULL`, sorted
--    `updatedDate DESC`. Walks the result in display order with no
--    filter or sort step.

DROP INDEX IF EXISTS idx_notes_pending;
CREATE INDEX IF NOT EXISTS idx_notes_pending
ON notes(uuid)
WHERE pendingUpload = 1;

CREATE INDEX IF NOT EXISTS idx_notes_pinned_live
ON notes(userId, updatedDate DESC)
WHERE isPinned = 1 AND deletedAt IS NULL;

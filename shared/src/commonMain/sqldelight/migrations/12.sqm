-- Index audit (2026-05-09). Adds missing hot-path indexes and tightens
-- existing ones to match the queries we actually run. Fresh installs get
-- the new indexes via the CREATE statements in each .sq file; existing
-- installs get them via this migration.

-- 1. exercises: `getExerciseByRemoteId(IfLive)` and `getExercisesByCategoryForUser`
-- both did full table scans on the catalog (~250 globals + customs). Sync
-- and the category-browse screen are hot paths.
CREATE INDEX IF NOT EXISTS idx_exercises_remoteId
ON exercises(remoteId)
WHERE remoteId IS NOT NULL;

CREATE INDEX IF NOT EXISTS idx_exercises_category_live
ON exercises(primaryCategoryUuid)
WHERE deletedAt IS NULL;

-- 2. photoMeasurements: every entry to the photo screen scanned the table.
CREATE INDEX IF NOT EXISTS idx_photoMeasurements_diary
ON photoMeasurements(userId, journalId);

-- 3. journals: convert full (userId) index to partial (userId WHERE deletedAt IS NULL)
-- to match the notes_user_live / bodyMeasurements_diary_live pattern.
-- `getJournals` and `getPersonalJournal` both filter `deletedAt IS NULL`.
DROP INDEX IF EXISTS idx_diaries_user;
CREATE INDEX IF NOT EXISTS idx_diaries_user_live
ON journals(userId)
WHERE deletedAt IS NULL;

-- 4. workoutExercises: existing single-column index on workoutRecordUuid
-- forced SQLite to fetch+sort children for `ORDER BY position ASC` after
-- the index seek. Composite (workoutRecordUuid, position) makes the
-- ORDER BY index-driven.
DROP INDEX IF EXISTS idx_workoutExercises_record;
CREATE INDEX IF NOT EXISTS idx_workoutExercises_record
ON workoutExercises(workoutRecordUuid, position);

-- 5. workoutSets: same pattern. `getWorkoutSetsByExercise` orders by
-- position; composite makes it sort-free.
DROP INDEX IF EXISTS idx_workoutSets_exercise;
CREATE INDEX IF NOT EXISTS idx_workoutSets_exercise
ON workoutSets(workoutExerciseUuid, position);

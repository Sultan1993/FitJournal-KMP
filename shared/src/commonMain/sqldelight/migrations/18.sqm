-- Index-name cleanup for the Diary→Journal product rename. The audit revealed
-- the SQL table was ALWAYS named `journals` (migration 8.sqm) and the foreign-
-- key columns `journalId` (migrations 2.sqm/7.sqm) — the rename only happened at
-- source / product level. The earlier draft of this migration tried to
-- `ALTER TABLE diaries RENAME TO journals` and would fail with "no such table"
-- on every existing device. This corrected migration only renames the indices
-- that still carry the old "diary" prefix.

DROP INDEX IF EXISTS idx_diaries_user_live;
DROP INDEX IF EXISTS idx_diaries_pending;
DROP INDEX IF EXISTS idx_diaries_user;
DROP INDEX IF EXISTS idx_workoutRecords_diary;
DROP INDEX IF EXISTS idx_workoutRecords_live_diary;
DROP INDEX IF EXISTS idx_bodyMeasurements_diary_live;
DROP INDEX IF EXISTS idx_bodyMeasurements_diary_type_live;

CREATE INDEX IF NOT EXISTS idx_journals_user_live ON journals(userId) WHERE deletedAt IS NULL;
CREATE INDEX IF NOT EXISTS idx_journals_pending ON journals(uuid) WHERE pendingUpload = 1;
CREATE INDEX IF NOT EXISTS idx_workoutRecords_live_journal ON workoutRecords(userId, journalId, date DESC, position ASC) WHERE deletedAt IS NULL;
CREATE INDEX IF NOT EXISTS idx_bodyMeasurements_journal_live ON bodyMeasurements(userId, journalId, measurementDate DESC) WHERE deletedAt IS NULL;
CREATE INDEX IF NOT EXISTS idx_bodyMeasurements_journal_type_live ON bodyMeasurements(userId, journalId, type, measurementDate DESC) WHERE deletedAt IS NULL;

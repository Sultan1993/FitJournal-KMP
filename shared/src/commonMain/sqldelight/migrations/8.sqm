-- Adds the local-first persistence layer for the Parse → AWS migration:
-- journals, workoutRecords, workoutExercises, workoutSets.
-- All statements are idempotent so this migration is safe even on databases
-- that already have these tables for any reason.

CREATE TABLE IF NOT EXISTS journals (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT,
    userId TEXT NOT NULL,
    name TEXT NOT NULL,
    comments TEXT,
    isPersonal INTEGER NOT NULL DEFAULT 0,
    workoutGoal INTEGER,
    deletedAt TEXT,
    pendingUpload INTEGER NOT NULL DEFAULT 1,
    createdDate TEXT NOT NULL,
    updatedDate TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_diaries_user ON journals(userId);
CREATE INDEX IF NOT EXISTS idx_diaries_pending ON journals(pendingUpload);

CREATE TABLE IF NOT EXISTS workoutRecords (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT,
    userId TEXT NOT NULL,
    journalId TEXT NOT NULL,
    date TEXT NOT NULL,
    position INTEGER NOT NULL,
    comment TEXT,
    startedAt TEXT,
    durationSec INTEGER,
    deletedAt TEXT,
    pendingUpload INTEGER NOT NULL DEFAULT 1,
    schemaVersion INTEGER NOT NULL DEFAULT 1,
    createdDate TEXT NOT NULL,
    updatedDate TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_workoutRecords_user_date ON workoutRecords(userId, date);
CREATE INDEX IF NOT EXISTS idx_workoutRecords_diary ON workoutRecords(journalId);
CREATE INDEX IF NOT EXISTS idx_workoutRecords_pending ON workoutRecords(pendingUpload);

CREATE TABLE IF NOT EXISTS workoutExercises (
    uuid TEXT PRIMARY KEY NOT NULL,
    workoutRecordUuid TEXT NOT NULL REFERENCES workoutRecords(uuid) ON DELETE CASCADE,
    exerciseUuid TEXT NOT NULL,
    position INTEGER NOT NULL,
    comment TEXT
);

CREATE INDEX IF NOT EXISTS idx_workoutExercises_record ON workoutExercises(workoutRecordUuid);
CREATE INDEX IF NOT EXISTS idx_workoutExercises_exercise ON workoutExercises(exerciseUuid);

CREATE TABLE IF NOT EXISTS workoutSets (
    uuid TEXT PRIMARY KEY NOT NULL,
    workoutExerciseUuid TEXT NOT NULL REFERENCES workoutExercises(uuid) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    weight REAL,
    reps INTEGER,
    distance REAL,
    duration INTEGER,
    difficultyType INTEGER NOT NULL DEFAULT 0,
    completed INTEGER NOT NULL DEFAULT 1
);

CREATE INDEX IF NOT EXISTS idx_workoutSets_exercise ON workoutSets(workoutExerciseUuid);

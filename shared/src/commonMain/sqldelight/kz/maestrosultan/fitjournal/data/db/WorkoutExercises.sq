CREATE TABLE workoutExercises (
    uuid TEXT PRIMARY KEY NOT NULL,
    workoutRecordUuid TEXT NOT NULL REFERENCES workoutRecords(uuid) ON DELETE CASCADE,
    exerciseUuid TEXT NOT NULL,
    position INTEGER NOT NULL,
    comment TEXT
);

-- Composite (workoutRecordUuid, position) so the canonical
-- `WHERE workoutRecordUuid = ? ORDER BY position ASC` is fully
-- index-driven (no post-fetch sort step).
CREATE INDEX idx_workoutExercises_record ON workoutExercises(workoutRecordUuid, position);
CREATE INDEX idx_workoutExercises_exercise ON workoutExercises(exerciseUuid);

getWorkoutExercisesByRecord:
SELECT *
FROM workoutExercises
WHERE workoutRecordUuid = ?
ORDER BY position ASC;

-- Bulk: child exercises across every live workout record in (user, journal)
-- within a date window. Companion to `getWorkoutRecordsByJournal` so the
-- repository can hydrate full trees in 3 SQL calls. `from` inclusive,
-- `to` exclusive. Callers that want "everything" pass `0000-01-01` /
-- `9999-12-31`. Caller groups by `workoutRecordUuid`.
--
-- ORDER BY matches the natural JOIN scan order so SQLite doesn't have
-- to materialize-and-sort: `idx_workoutRecords_live_diary` yields wr
-- rows in `(date DESC, position ASC)`, and for each wr we get its
-- workoutExercises in `position ASC` via the composite
-- `idx_workoutExercises_record`. Rows for the same record stay
-- contiguous (one record = one date), so `groupBy { workoutRecordUuid }`
-- in the caller still yields position-sorted child lists per record.
getWorkoutExercisesByJournal:
SELECT we.*
FROM workoutExercises we
JOIN workoutRecords wr ON wr.uuid = we.workoutRecordUuid
WHERE wr.userId = ?
AND wr.journalId = ?
AND wr.date >= ?
AND wr.date < ?
AND wr.deletedAt IS NULL
ORDER BY wr.date DESC, we.position ASC;

createWorkoutExercise:
INSERT INTO workoutExercises(uuid, workoutRecordUuid, exerciseUuid, position, comment)
VALUES (?, ?, ?, ?, ?);

-- Wipe-and-replace step inside `replaceWorkoutRecord`. Sets cascade
-- via FK ON DELETE CASCADE so this single DELETE drops all child sets
-- for the record's exercises in one shot.
deleteWorkoutExercisesByRecord:
DELETE FROM workoutExercises
WHERE workoutRecordUuid = ?;

-- Full wipe. Used once on FJ1.x → FJ2.0 upgrade to drop legacy
-- parseUserId-keyed rows before hydration repopulates with awsUserId.
-- Belt-and-braces against `PRAGMA foreign_keys=OFF` paths: the parent
-- workoutRecords wipe should cascade-delete these via FK, but we call
-- this explicitly so the wipe is correct even if the pragma is off.
wipeAll:
DELETE FROM workoutExercises;

import kotlin.Boolean;

CREATE TABLE workoutSets (
    uuid TEXT PRIMARY KEY NOT NULL,
    workoutExerciseUuid TEXT NOT NULL REFERENCES workoutExercises(uuid) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    weight REAL,
    reps INTEGER,
    distance REAL,
    duration INTEGER,
    difficultyType INTEGER NOT NULL DEFAULT 0,
    completed INTEGER AS Boolean NOT NULL DEFAULT 1
);

-- Composite (workoutExerciseUuid, position) so
-- `WHERE workoutExerciseUuid = ? ORDER BY position ASC` is index-driven.
CREATE INDEX idx_workoutSets_exercise ON workoutSets(workoutExerciseUuid, position);

getWorkoutSetsByExercise:
SELECT *
FROM workoutSets
WHERE workoutExerciseUuid = ?
ORDER BY position ASC;

-- Bulk: every set under [workoutRecordUuid] in one SQL call. Replaces
-- the per-exercise N+1 loop in `WorkoutsDBDataSource.childrenOf`. Plan:
-- `idx_workoutExercises_record` resolves the record's exercises → PK
-- join → `idx_workoutSets_exercise` composite walk so the natural scan
-- order matches the ORDER BY (no sort step).
getWorkoutSetsByRecord:
SELECT ws.*
FROM workoutSets ws
JOIN workoutExercises we ON we.uuid = ws.workoutExerciseUuid
WHERE we.workoutRecordUuid = ?
ORDER BY we.position ASC, ws.position ASC;

-- Bulk: sets across every live record in (user, journal) within a date
-- window. Companion to `getWorkoutExercisesByJournal`; same windowing
-- semantics. Caller groups by `workoutExerciseUuid`.
--
-- ORDER BY matches natural JOIN scan order so SQLite doesn't sort:
-- wr in `(date DESC, position ASC)` (partial index) → we in `position
-- ASC` (composite) → ws in `position ASC` (composite). Rows for the
-- same workoutExercise stay contiguous, so the caller's
-- `groupBy { workoutExerciseUuid }` still yields position-sorted
-- set lists per exercise.
getWorkoutSetsByJournal:
SELECT ws.*
FROM workoutSets ws
JOIN workoutExercises we ON we.uuid = ws.workoutExerciseUuid
JOIN workoutRecords wr ON wr.uuid = we.workoutRecordUuid
WHERE wr.userId = ?
AND wr.journalId = ?
AND wr.date >= ?
AND wr.date < ?
AND wr.deletedAt IS NULL
ORDER BY wr.date DESC, we.position ASC, ws.position ASC;

-- Single SQL feeding the entire exercise details page (Info / History /
-- Stats). Returns every set in (user, journal) for a specific catalog
-- exercise within `[from, to)`, with the parent record's `date` and the
-- workoutExercise's `comment` projected so callers can group + render
-- in Kotlin without a second query. Same 1-year window as the rest of
-- the app.
--
-- Plan: `idx_workoutExercises_exercise` resolves we by exerciseUuid
-- (~50–200 rows for a popular catalog exercise) → PK join to wr → PK
-- join to ws via `idx_workoutSets_exercise` (composite on
-- workoutExerciseUuid, position). ORDER BY matches the natural scan
-- order so SQLite skips a sort step.
getWorkoutSetsForExerciseInJournal:
SELECT ws.*, wr.date AS recordDate, we.comment AS workoutExerciseComment
FROM workoutSets ws
JOIN workoutExercises we ON we.uuid = ws.workoutExerciseUuid
JOIN workoutRecords wr ON wr.uuid = we.workoutRecordUuid
WHERE we.exerciseUuid = ?
AND wr.userId = ?
AND wr.journalId = ?
AND wr.date >= ?
AND wr.date < ?
AND wr.deletedAt IS NULL
-- `wr.position DESC` tiebreaks two records on the SAME day so the LATER one
-- (higher position) sorts first — otherwise "last session" / History can show
-- the earlier same-day occurrence (undefined rowid order). `wr.uuid` is a final
-- deterministic tiebreak for the rare multi-device same-date/same-position
-- collision (matches getWorkoutRecordsByJournal).
ORDER BY wr.date DESC, wr.position DESC, wr.uuid ASC, we.position ASC, ws.position ASC;

-- "The most recent prior occurrence of each of these exercises, before the
-- given date" — the boundary-case source for `WorkoutExercise.lastOccurrence`
-- ("you did 100kg×10 last time"). Pre-FJ-2.0 these hints were stored columns on
-- the Parse WorkoutSet row, written at log time; the SQLite schema doesn't carry
-- them, so we derive on read instead.
--
-- For a set of catalog exercises sharing ONE cutoff date, returns the winning
-- workoutExercise.uuid + its record date per exercise — one query instead of the
-- per-exercise N+1 loop `DefaultRecordRepository.buildLastOccurrenceMap` would
-- otherwise need for exercises with no in-memory predecessor. Expressed as NOT
-- EXISTS rather than a window function so it runs on the SqliteDialect 3.18
-- baseline. Pair with getSetsForWorkoutExercises to fetch the sets themselves.
--
-- Tiebreakers: `wr.position DESC` picks the LATER record when a user logs
-- multiple workouts on one date (we.position alone is meaningless across
-- records — it's per-record). Strict `<` on the date keeps an exercise out of
-- its own lookup.
--
-- Edge case — no prior occurrence: yields no row for that exercise, and the
-- caller leaves `lastOccurrence` null.
getLastWorkoutExercisesForExercisesBeforeDate:
SELECT we.exerciseUuid AS exerciseUuid, we.uuid AS weUuid, wr.date AS recordDate
FROM workoutExercises we
JOIN workoutRecords wr ON wr.uuid = we.workoutRecordUuid
WHERE we.exerciseUuid IN :exerciseUuids
AND wr.userId = :userId
AND wr.journalId = :journalId
AND wr.date < :beforeDate
AND wr.deletedAt IS NULL
AND NOT EXISTS (
    SELECT 1
    FROM workoutExercises we2
    JOIN workoutRecords wr2 ON wr2.uuid = we2.workoutRecordUuid
    WHERE we2.exerciseUuid = we.exerciseUuid
    AND wr2.userId = :userId
    AND wr2.journalId = :journalId
    AND wr2.date < :beforeDate
    AND wr2.deletedAt IS NULL
    AND (
        wr2.date > wr.date
        OR (wr2.date = wr.date AND wr2.position > wr.position)
        OR (wr2.date = wr.date AND wr2.position = wr.position AND we2.position > we.position)
    )
);

-- All sets (position-ordered) for each of the given workoutExercises.
-- Companion to getLastWorkoutExercisesForExercisesBeforeDate: feeds the
-- per-position previous-set hint so set N of the current exercise maps to
-- set N of the most recent prior occurrence (not that occurrence's last
-- set stamped onto every set — see DefaultRecordRepository.mapExercise).
getSetsForWorkoutExercises:
SELECT *
FROM workoutSets
WHERE workoutExerciseUuid IN ?
ORDER BY position ASC;

-- All set writes go through `replaceWorkoutRecord` (whole-tree replace),
-- so only INSERT is needed at this layer. Updates / deletes are
-- handled by the parent record's DELETE-and-reinsert step plus FK
-- CASCADE.
createWorkoutSet:
INSERT INTO workoutSets(uuid, workoutExerciseUuid, position, weight, reps, distance, duration, difficultyType, completed)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Full wipe used on FJ1.x → FJ2.0 upgrade before hydration.
wipeAll:
DELETE FROM workoutSets;

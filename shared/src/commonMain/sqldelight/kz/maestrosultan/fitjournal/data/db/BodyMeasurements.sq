import kotlin.Boolean;

CREATE TABLE bodyMeasurements (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT,
    userId TEXT NOT NULL,
    journalId TEXT NOT NULL,
    type TEXT NOT NULL,
    value REAL NOT NULL,
    comment TEXT,
    measurementDate TEXT NOT NULL,
    createdDate TEXT NOT NULL,
    updatedDate TEXT NOT NULL,
    pendingUpload INTEGER AS Boolean NOT NULL DEFAULT 0,
    deletedAt TEXT
);

-- Sync push drain. Partial on `pendingUpload = 1` so the index scales
-- with the (typically empty) backlog, not the whole table.
CREATE INDEX idx_bodyMeasurements_pending ON bodyMeasurements(uuid) WHERE pendingUpload = 1;
-- Drives `getBodyMeasurements`. `measurementDate DESC` lets SQLite walk
-- the index directly in display order — no sort step.
CREATE INDEX idx_bodyMeasurements_journal_live ON bodyMeasurements(userId, journalId, measurementDate DESC) WHERE deletedAt IS NULL;
-- Drives `getBodyMeasurementsByType` (per-measurement chart screen).
-- The leading three keys cover the WHERE; `measurementDate DESC`
-- covers the ORDER BY.
CREATE INDEX idx_bodyMeasurements_journal_type_live ON bodyMeasurements(userId, journalId, type, measurementDate DESC) WHERE deletedAt IS NULL;

getBodyMeasurements:
SELECT *
FROM bodyMeasurements
WHERE userId = ?
AND journalId = ?
AND deletedAt IS NULL
ORDER BY measurementDate DESC;

getBodyMeasurementsByType:
SELECT *
FROM bodyMeasurements
WHERE userId = ?
AND journalId = ?
AND type = ?
AND deletedAt IS NULL
ORDER BY measurementDate DESC;

-- UI-facing single-row read. Tombstones filtered — a soft-deleted row
-- looks like "not found" to the UI.
getBodyMeasurementById:
SELECT *
FROM bodyMeasurements
WHERE uuid = ?
AND deletedAt IS NULL;

-- Sync-only single-row read. Sees tombstones so the orchestrator can
-- compare local vs remote `deletedAt` on pull and propagate the
-- deletion. UI paths must use [getBodyMeasurementById].
getBodyMeasurementByIdIncludingDeleted:
SELECT *
FROM bodyMeasurements
WHERE uuid = ?;

-- Pending uploads, scoped to a single user. After sign-out/sign-in
-- as a different user, the previous user's stale pendingUpload rows
-- must NOT be pushed under the new user's session.
getPendingUploads:
SELECT *
FROM bodyMeasurements
WHERE pendingUpload = 1
AND userId = ?;

createBodyMeasurement:
INSERT INTO bodyMeasurements(uuid, remoteId, userId, journalId, type, value, comment, measurementDate, createdDate, updatedDate, pendingUpload)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Live-only update — tombstoned rows should never be edited from UI.
updateBodyMeasurement:
UPDATE bodyMeasurements
SET value = ?, comment = ?, measurementDate = ?, updatedDate = ?, pendingUpload = 1
WHERE uuid = ?
AND deletedAt IS NULL;

-- Push-success ack. No `deletedAt IS NULL` filter — tombstones must
-- also clear their pendingUpload after a successful tombstone push.
-- Conditional on the row still being what was uploaded — see the long note on
-- `updateExerciseRemoteId`. An edit landing during the round trip stays pending
-- instead of being dropped and then reverted by the pull.
updateBodyMeasurementRemoteId:
UPDATE bodyMeasurements
SET remoteId = ?, pendingUpload = 0
WHERE uuid = ? AND updatedDate IS ?;

-- Sync-pull upsert: writes the row from AWS without bumping pendingUpload.
-- Callers must check `pendingUpload=1` on the existing row before calling
-- this and skip if unpushed local writes would be stomped (the local-wins
-- escape hatch in SyncOrchestrator.applyBodyMeasurementRemote).
upsertBodyMeasurementFromRemote:
INSERT OR REPLACE INTO bodyMeasurements(uuid, remoteId, userId, journalId, type, value, comment, measurementDate, createdDate, updatedDate, pendingUpload, deletedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?);

-- Idempotent on live rows only — re-tombstoning shifts `deletedAt`
-- for no reason.
softDeleteBodyMeasurement:
UPDATE bodyMeasurements
SET deletedAt = ?, updatedDate = ?, pendingUpload = 1
WHERE uuid = ?
AND deletedAt IS NULL;

-- Cascade for journal deletion. Measurements are journal-scoped but have no
-- FOREIGN KEY to `journals`, so deleting a journal used to strand them: no
-- reparent path exists for this table (unlike workoutRecords), so they simply
-- became unreachable — every read scopes to a journalId the picker can no
-- longer offer. Leads with `userId` to use `idx_bodyMeasurements_journal_live`.
softDeleteBodyMeasurementsByJournal:
UPDATE bodyMeasurements
SET deletedAt = ?, updatedDate = ?, pendingUpload = 1
WHERE userId = ?
AND journalId = ?
AND deletedAt IS NULL;

-- Account deletion. Tombstone rather than hard purge: a DELETEd row leaves no
-- `pendingUpload=1` behind, so the blocking drain in DeleteAccountUseCase has
-- nothing to push and the AWS row outlives the account forever. Mirrors
-- softDeleteJournalsByUserId, which always got this right. The local rows are
-- dropped by LocalDbWiper once the drain confirms the tombstones landed.
softDeleteBodyMeasurementsByUserId:
UPDATE bodyMeasurements
SET deletedAt = ?, updatedDate = ?, pendingUpload = 1
WHERE userId = ?
AND deletedAt IS NULL;

-- Full wipe. Used once on FJ1.x → FJ2.0 upgrade to drop legacy
-- parseUserId-keyed rows before hydration repopulates with awsUserId.
wipeAll:
DELETE FROM bodyMeasurements;

import kotlin.Boolean;

CREATE TABLE diaries (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT,
    userId TEXT NOT NULL,
    name TEXT NOT NULL,
    comments TEXT,
    isPersonal INTEGER AS Boolean NOT NULL DEFAULT 0,
    workoutGoal INTEGER,
    deletedAt TEXT,
    pendingUpload INTEGER AS Boolean NOT NULL DEFAULT 1,
    createdDate TEXT NOT NULL,
    updatedDate TEXT NOT NULL
);

-- Partial: every UI read filters `deletedAt IS NULL`. Skipping tombstoned
-- rows from the index keeps it small and hot-cached. Mirrors the pattern
-- used by notes/bodyMeasurements.
CREATE INDEX idx_diaries_user_live ON diaries(userId) WHERE deletedAt IS NULL;
CREATE INDEX idx_diaries_pending ON diaries(pendingUpload);

getDiaries:
SELECT *
FROM diaries
WHERE userId = ?
AND deletedAt IS NULL;

getDiaryById:
SELECT *
FROM diaries
WHERE uuid = ?;

-- Tombstone-filtered variant for UI reads. `getDiaryById` keeps soft-
-- deleted rows visible because sync paths need to see them; UI repo
-- methods (DefaultDiaryRepository.getDiaryById / getDiaryByIdFlow) call
-- this one instead so a deleted diary doesn't render as live.
getDiaryByIdIfLive:
SELECT *
FROM diaries
WHERE uuid = ?
AND deletedAt IS NULL;

getPersonalDiary:
SELECT *
FROM diaries
WHERE userId = ?
AND isPersonal = 1
AND deletedAt IS NULL
LIMIT 1;

getPendingUploads:
SELECT *
FROM diaries
WHERE pendingUpload = 1;

createDiary:
INSERT INTO diaries(uuid, remoteId, userId, name, comments, isPersonal, workoutGoal, pendingUpload, createdDate, updatedDate)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDiary:
UPDATE diaries
SET name = ?, comments = ?, workoutGoal = ?, updatedDate = ?, pendingUpload = 1
WHERE uuid = ?;

updateDiaryRemoteId:
UPDATE diaries
SET remoteId = ?, pendingUpload = 0
WHERE uuid = ?;

-- Sync-pull upsert: writes the row from AWS without bumping pendingUpload.
-- Used by SyncOrchestrator pull. Callers must check `pendingUpload=1` on
-- the existing row before calling this and skip if unpushed local writes
-- would be stomped (the local-wins escape hatch).
upsertDiaryFromRemote:
INSERT OR REPLACE INTO diaries(uuid, remoteId, userId, name, comments, isPersonal, workoutGoal, deletedAt, pendingUpload, createdDate, updatedDate)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?);

softDeleteDiary:
UPDATE diaries
SET deletedAt = ?, updatedDate = ?, pendingUpload = 1
WHERE uuid = ?;

deleteDiary:
DELETE FROM diaries
WHERE uuid = ?;

deleteUserDiaries:
DELETE FROM diaries
WHERE userId = ?;

deleteAllDiaries:
DELETE FROM diaries;

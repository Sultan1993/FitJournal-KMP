-- Workout sessions: the start/end timing for one workout. A (user, journal,
-- calendar day) can hold more than one — `workoutNumber` (1 = first/morning,
-- 2 = evening, ...) distinguishes them and matches the `workoutNumber` on the
-- workoutRecords logged during that workout. `endedAt IS NULL` means running;
-- at most ONE running row per user app-wide (repository invariant,
-- transaction-enforced — see startSession).
--
-- Local-only mirror of the AWSWorkoutSession @model (deployed to staging
-- 2026-07-31). Sync (remoteId/pendingUpload/deletedAt) is a later increment;
-- until then a row lives and dies on-device, which is why duration cannot yet
-- survive reinstall.
--
-- date = LocalDate.toString(); startedAt/endedAt = Instant ISO-8601 TEXT.
CREATE TABLE workoutSessions (
    uuid TEXT PRIMARY KEY NOT NULL,
    userId TEXT NOT NULL,
    journalId TEXT NOT NULL,
    date TEXT NOT NULL,
    workoutNumber INTEGER NOT NULL,
    startedAt TEXT NOT NULL,
    endedAt TEXT
);

-- One session per page: a (userId, journalId, date, workoutNumber) has at most
-- one session. UNIQUE so a double-Start on the same page cannot create two rows;
-- startSession's idempotent branch relies on this being the single matching row.
CREATE UNIQUE INDEX idx_workoutSessions_page
ON workoutSessions(userId, journalId, date, workoutNumber);
-- Hot path: "is anything running" on every list render.
CREATE INDEX idx_workoutSessions_running
ON workoutSessions(userId) WHERE endedAt IS NULL;

-- One page's session (running or finished), or none. The UNIQUE index makes this
-- at most one row.
getSessionByWorkoutNumber:
SELECT * FROM workoutSessions
WHERE userId = ? AND journalId = ? AND date = ? AND workoutNumber = ?;

-- Read-back by primary key (startSession / endRunningSession read-your-writes).
getSessionById:
SELECT * FROM workoutSessions WHERE uuid = ?;

-- Every session for a day, ascending by workoutNumber — the pager reads this to
-- learn which pages carry timing.
getSessionsForDay:
SELECT * FROM workoutSessions
WHERE userId = ? AND journalId = ? AND date = ?
ORDER BY workoutNumber ASC;

-- The one running session app-wide (invariant: at most one). ORDER BY is
-- defensive: a repository bug must not make the answer nondeterministic.
getRunningSession:
SELECT * FROM workoutSessions
WHERE userId = ? AND endedAt IS NULL
ORDER BY startedAt DESC
LIMIT 1;

-- Completed workouts in (user, journal) within an INCLUSIVE [from, to] date
-- range, excluding one session by uuid — the "workout N this week" ordinal for
-- the post-workout summary, which counts every OTHER finished workout of the
-- week (the just-finished session itself is the excluded uuid). `endedAt IS
-- NOT NULL` keeps a still-running workout out of the count. Both bounds are
-- inclusive (unlike the half-open record windows): callers pass the week's
-- first and last day, not a next-week sentinel. This table has no deletedAt —
-- session rows are local-only in this increment and are hard-deleted.
countCompletedSessionsBetween:
SELECT COUNT(*) FROM workoutSessions
WHERE userId = ? AND journalId = ?
  AND date >= ? AND date <= ?
  AND endedAt IS NOT NULL
  AND uuid != ?;

createSession:
INSERT INTO workoutSessions(uuid, userId, journalId, date, workoutNumber, startedAt, endedAt)
VALUES (?, ?, ?, ?, ?, ?, NULL);

-- Explicit end AND the stale auto-finish. Running rows only — a second call is a
-- no-op, never an endedAt shift.
endSessionById:
UPDATE workoutSessions
SET endedAt = ?
WHERE uuid = ? AND endedAt IS NULL;

-- Discard ONE session by id — the empty-workout cleanup: a workout with no
-- records is not a workout, so a session started-then-ended-with-nothing-logged
-- (or emptied by deleting every record) is deleted rather than kept. userId is
-- an extra guard so a stray uuid can never touch another user's row. No-op if
-- the row is already gone.
deleteWorkoutSessionByUuid:
DELETE FROM workoutSessions WHERE uuid = ? AND userId = ?;

-- Hard purge, delete-account flow (mirrors deleteWorkoutRecordsByUserId).
deleteWorkoutSessionsByUserId:
DELETE FROM workoutSessions WHERE userId = ?;

-- FJ2.0 wipe-gate parity: keeps DefaultLocalDbWiper's "every user-scoped
-- table" contract honest.
wipeAll:
DELETE FROM workoutSessions;

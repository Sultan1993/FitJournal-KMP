import kotlin.Boolean;

CREATE TABLE workoutRecords (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT,
    userId TEXT NOT NULL,
    journalId TEXT NOT NULL,
    date TEXT NOT NULL,
    position INTEGER NOT NULL,
    comment TEXT,
    startedAt TEXT,
    durationSec INTEGER,
    deletedAt TEXT,
    pendingUpload INTEGER AS Boolean NOT NULL DEFAULT 1,
    schemaVersion INTEGER NOT NULL DEFAULT 1,
    createdDate TEXT NOT NULL,
    updatedDate TEXT NOT NULL,
    -- Which workout of the day this record belongs to (1 = first/morning,
    -- 2 = evening, ...). DEFAULT 1 so the migration backfills every existing row
    -- to workout 1 and logging on the first/only workout needs no explicit
    -- value. A record's session (its start/end timing) is whichever
    -- `workoutSessions` row shares its (userId, journalId, date, workoutNumber);
    -- records with no such row were logged without pressing Start and have no
    -- session. NOT the reverse of the old `sessionId` groundwork — this is an
    -- ordinal grouping key, not a foreign key.
    workoutNumber INTEGER NOT NULL DEFAULT 1
);

-- Sole hot-path index: every UI read scopes to (userId, journalId), filters
-- live, orders by date DESC, then workoutNumber ASC, then position ASC. Partial
-- on `deletedAt IS NULL` keeps it tight. `workoutNumber` sits before `position`
-- because position is page-relative (0-based within each workout), so it only
-- orders records inside their own workout — the full day order is
-- (date, workoutNumber, position). The previous `(userId, date)` and
-- `(journalId)` indices were redundant on a single-user-per-device app.
CREATE INDEX idx_workoutRecords_live_journal ON workoutRecords(userId, journalId, date DESC, workoutNumber ASC, position ASC) WHERE deletedAt IS NULL;
-- Sync push drain. Partial on `pendingUpload = 1` so the index scales
-- with the (typically empty) backlog, not the whole table.
CREATE INDEX idx_workoutRecords_pending ON workoutRecords(uuid) WHERE pendingUpload = 1;

-- Records in (user, journal). Date filter is half-open: `from` inclusive,
-- `to` exclusive. Callers that want "everything" pass an epoch lower
-- bound and `9999-12-31` upper bound; one shape covers full-journal scans,
-- monthly windows, and date-day filters.
getWorkoutRecordsByJournal:
SELECT *
FROM workoutRecords
WHERE userId = ?
AND journalId = ?
AND date >= ?
AND date < ?
AND deletedAt IS NULL
-- Order: date DESC, then workoutNumber ASC (group each day's workouts), then
-- position ASC within a workout. `uuid` is the final tiebreaker so ordering is
-- deterministic even when two records share a (workoutNumber, position) — each
-- device assigns position as local max+1, so AWS sync can deliver same-position
-- records from another device. Without it same-position rows render in arbitrary
-- rowid order and superset "next record" becomes ambiguous.
ORDER BY date DESC, workoutNumber ASC, position ASC, uuid ASC;


-- Single-record read for UI/repo. Filters tombstones — a soft-deleted
-- record looks like "not found" to the UI.
getWorkoutRecordById:
SELECT *
FROM workoutRecords
WHERE uuid = ?
AND deletedAt IS NULL;

-- Sync-only single-record read. Sees tombstones so SyncOrchestrator
-- can push a soft-delete to AWS (or confirm an already-pushed one).
-- UI/repo paths must use [getWorkoutRecordById] above.
getWorkoutRecordByIdIncludingDeleted:
SELECT *
FROM workoutRecords
WHERE uuid = ?;

-- Pending uploads, scoped to a single user. After sign-out/sign-in
-- as a different user, the previous user's stale pendingUpload rows
-- must NOT be pushed under the new user's session.
getPendingUploads:
SELECT *
FROM workoutRecords
WHERE pendingUpload = 1
AND userId = ?;

-- Lightweight change signal for the home screen. Observed as a Flow:
-- SQLDelight re-emits whenever the workoutRecords table is written
-- (insert / update / soft-delete). Every write bumps `updatedDate`
-- (set edits go through replaceWorkoutRecord → updateWorkoutRecord,
-- which sets updatedDate), so MAX(updatedDate) changes on ANY content
-- change — not just record add/delete. coalesce → non-null empty
-- string when the journal has no records yet.
observeJournalRecordsSignal:
SELECT coalesce(MAX(updatedDate), '') AS signal
FROM workoutRecords
WHERE userId = ?
AND journalId = ?;

-- Metered WORKOUTS for the free-quota meter: one row per
-- (journalId, date, workoutNumber) this user has EVER logged; COUNT them.
--   * NO start boundary. Only a never-subscriber is ever counted (WorkoutQuotaGate
--     answers "already subscribed" without touching this query), and under the
--     hard wall a never-subscriber could not log anything — so there is no history
--     for a cutoff instant to protect. The pre-paywall free era is the one
--     exception and those accounts have been walled out for years.
--   * workoutNumber IS part of the key: two workouts logged on one date are two
--     counted workouts. The slot is stable across a reinstall because both
--     remote upserts thread the column (see upsertWorkoutRecordFromRemote), so
--     a pull re-materialises the same (date, workoutNumber) grouping it pushed.
--   * userId only, no journalId filter: the quota is per ACCOUNT, across journals.
--   * Tombstones are COUNTED ON PURPOSE — deleting a workout must not refund
--     quota. User-facing deletes are soft (softDeleteWorkoutRecord*).
--   * A user-scoped scan. idx_workoutRecords_live_journal is partial on
--     `deletedAt IS NULL` and CANNOT serve this; fine at this table size.
countMeteredWorkouts:
SELECT COUNT(*) FROM (
    SELECT journalId, date, workoutNumber
    FROM workoutRecords
    WHERE userId = ?
    GROUP BY journalId, date, workoutNumber
);

-- Does this workout slot hold any record (live OR tombstoned)? Sole consumer is
-- WorkoutQuotaGate: a slot that already holds a record stays writable at
-- exhaustion, which is what "you may write in a workout that already exists"
-- means — it is why pressing Start costs nothing and why nobody is amputated
-- part-way through the workout they are standing in the gym doing.
--
-- DELETED-INCLUSIVE, and that has to match countMeteredWorkouts, which has no
-- deletedAt filter either. If this one excluded tombstones an emptied slot would
-- still be CHARGED by the meter while being unwritable — quota spent on a workout
-- you cannot use.
--
-- EXISTS, not COUNT(*): the only consumer wants a boolean, and this runs on every
-- gated tap, so stopping at the first matching row beats counting every record in
-- the slot.
workoutSlotExists:
SELECT EXISTS(
    SELECT 1
    FROM workoutRecords
    WHERE userId = ? AND journalId = ? AND date = ? AND workoutNumber = ?
    LIMIT 1
);

-- When did the user last touch THIS workout? MAX(updatedDate) over its records —
-- every write bumps updatedDate (adds, set edits, soft deletes), so this is the
-- activity signal `workoutSessions` does not carry: the table has startedAt and
-- endedAt and nothing in between.
--
-- Tombstones are INCLUDED on purpose: deleting a set at 19:40 is still something
-- the user did at 19:40. Excluding them would date the workout to before an edit
-- the user actually made.
--
-- Returns NULL when the workout has no records at all — a session started and
-- never used. That is EMPTY, not forgotten, and the empty-workout rule deletes it.
lastActivityInWorkout:
SELECT MAX(updatedDate)
FROM workoutRecords
WHERE userId = ? AND journalId = ? AND date = ? AND workoutNumber = ?;

-- Does this workout slot hold any LIVE record? The tombstone-EXCLUSIVE twin of
-- workoutSlotExists, and the two must NOT be merged into one query — they answer
-- opposite questions on purpose:
--   * workoutSlotExists counts tombstones, so an emptied slot is still CHARGED by
--     the meter and therefore stays writable (quota must not be refundable).
--   * this one does not, because a workout whose every record was deleted logged
--     NOTHING, and the forgotten-session rule must discard it rather than record
--     a zero-set workout the manual End path would have deleted.
liveWorkoutRecordExists:
SELECT EXISTS(
    SELECT 1
    FROM workoutRecords
    WHERE userId = ? AND journalId = ? AND date = ? AND workoutNumber = ?
    AND deletedAt IS NULL
    LIMIT 1
);

createWorkoutRecord:
INSERT INTO workoutRecords(uuid, remoteId, userId, journalId, date, position, comment, startedAt, durationSec, pendingUpload, createdDate, updatedDate, workoutNumber)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Live-only update. Tombstoned rows are no-ops — a UI write should
-- never land on a deleted record, and the predicate makes that explicit.
updateWorkoutRecord:
UPDATE workoutRecords
SET position = ?, comment = ?, startedAt = ?, durationSec = ?, updatedDate = ?, pendingUpload = 1
WHERE uuid = ?
AND deletedAt IS NULL;

-- Conditional on the row still being what was uploaded — see the long note on
-- `updateExerciseRemoteId`. This is the one that mattered most: logging another
-- set mid-push would otherwise clear the flag, and the SAME tick's pull would
-- then rebuild the tree from the server copy, losing the set outright.
-- The caller passes the updatedDate of the tree it actually uploaded (push
-- re-reads the tree before sending), not the enumerated snapshot's.
updateWorkoutRecordRemoteId:
UPDATE workoutRecords
SET remoteId = ?, pendingUpload = 0
WHERE uuid = ? AND updatedDate IS ?;

-- Sync-pull upsert for the parent record. Children (workoutExercises +
-- workoutSets) are wiped via FK ON DELETE CASCADE when the row is replaced
-- and re-created by the orchestrator from the decoded payload.
-- Callers must check `pendingUpload=1` on the existing row first to honor
-- the local-wins escape hatch.
-- `workoutNumber` MUST stay in this column list: INSERT OR REPLACE drops any
-- unlisted column to its table DEFAULT (1), which on every pull would collapse
-- multi-workout days onto workout 1. The orchestrator threads the pulled
-- AWSWorkoutRecord.workoutNumber (coalesced to 1 for legacy null rows).
upsertWorkoutRecordFromRemote:
INSERT OR REPLACE INTO workoutRecords(uuid, remoteId, userId, journalId, date, position, comment, startedAt, durationSec, deletedAt, pendingUpload, schemaVersion, createdDate, updatedDate, workoutNumber)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?, ?);

-- Same shape as the above but hardcodes pendingUpload=1. Used by the
-- orchestrator's orphan-reparent path: a remote workout references a
-- journalId that no longer exists locally (e.g. parent journal dropped
-- during a destructive schema migration). We rewrite `journalId` to the
-- user's personal journal and mark dirty so push corrects AWS on the
-- next tick.
-- `workoutNumber` MUST stay in this column list (see upsertWorkoutRecordFromRemote):
-- INSERT OR REPLACE would otherwise reset it to the table DEFAULT (1) on pull.
upsertWorkoutRecordFromRemoteAsPending:
INSERT OR REPLACE INTO workoutRecords(uuid, remoteId, userId, journalId, date, position, comment, startedAt, durationSec, deletedAt, pendingUpload, schemaVersion, createdDate, updatedDate, workoutNumber)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?);

-- Idempotent on live rows only — re-tombstoning shifts `deletedAt`
-- and bumps `updatedDate` for no reason; the predicate makes the
-- second call a no-op.
softDeleteWorkoutRecord:
UPDATE workoutRecords
SET deletedAt = ?, updatedDate = ?, pendingUpload = 1
WHERE uuid = ?
AND deletedAt IS NULL;

-- Cascade for journal deletion. `journalId` has no FOREIGN KEY (the only FK
-- chain here is sets → exercises → records), so deleting a journal used to
-- leave its records live: invisible locally, but the sync pull treats a
-- tombstoned parent as invalid and REPARENTS them into the personal journal,
-- so they resurfaced there on the next device. Leads with `userId` to use
-- `idx_workoutRecords_live_journal`. Live rows only, so re-deleting a journal
-- is a no-op rather than a `deletedAt` shift.
softDeleteWorkoutRecordsByJournal:
UPDATE workoutRecords
SET deletedAt = ?, updatedDate = ?, pendingUpload = 1
WHERE userId = ?
AND journalId = ?
AND deletedAt IS NULL;

-- Hard purge by user. Only used by the delete-account flow.
deleteWorkoutRecordsByUserId:
DELETE FROM workoutRecords
WHERE userId = ?;

-- Full wipe. Used once on FJ1.x → FJ2.0 upgrade to drop legacy
-- parseUserId-keyed rows before hydration repopulates with awsUserId.
-- FK ON DELETE CASCADE on workoutExercises/workoutSets handles children
-- when PRAGMA foreign_keys=ON.
wipeAll:
DELETE FROM workoutRecords;

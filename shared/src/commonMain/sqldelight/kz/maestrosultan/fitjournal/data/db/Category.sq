CREATE TABLE categories (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT NOT NULL,
    nameEn TEXT NOT NULL,
    nameRu TEXT NOT NULL,
    nameUk TEXT NOT NULL,
    type INTEGER NOT NULL,
    details TEXT
);

----------------------
-- "type" row by index
-- CHEST = 0,
-- BACK = 1,
-- BICEPS,
-- TRICEPS,
-- FOREARMS,
-- SHOULDERS,
-- TRAPEZIUS,
-- QUADRICEPS,
-- HAMSTRINGS,
-- GLUTES,
-- CALVES,
-- ABS,
-- CARDIO,
-- OTHER;
----------------------

getAllCategories:
SELECT *
FROM categories;

getCategoryByUuid:
SELECT *
FROM categories
WHERE uuid = ?;

getCategoryByRemoteId:
SELECT *
FROM categories
WHERE remoteId = ?;

createCategory:
INSERT INTO categories(uuid, remoteId, nameEn, nameRu, nameUk, type, details)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Sync-pull upsert: writes the row from AWS without any pendingUpload flag.
-- Used by SyncOrchestrator pullGlobalCatalog. Idempotent — safe to call every tick.
upsertCategoryFromRemote:
INSERT OR REPLACE INTO categories(uuid, remoteId, nameEn, nameRu, nameUk, type, details)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Full wipe. Used once on FJ1.x → FJ2.0 upgrade to drop legacy
-- parseUserId-keyed rows before hydration repopulates with awsUserId.
wipeAll:
DELETE FROM categories;

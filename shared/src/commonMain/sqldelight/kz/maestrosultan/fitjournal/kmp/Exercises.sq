import kotlin.Boolean;

CREATE TABLE exercises (
    uuid TEXT PRIMARY KEY NOT NULL,
    remoteId TEXT NOT NULL,
    nameEn TEXT NOT NULL,
    nameRu TEXT NOT NULL,
    nameUk TEXT,
    details TEXT,
    image1 TEXT,
    image2 TEXT,
    resultType INTEGER NOT NULL,
    primaryCategoryUuid TEXT NOT NULL,
    secondaryCategoryUuids TEXT,
    global INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (primaryCategoryUuid) REFERENCES categories(uuid)
);

getAllExercises:
SELECT *
FROM exercises;

getExercisesByCategoryUuid:
SELECT *
FROM exercises
WHERE primaryCategoryUuid == ?;

getExerciseByUuid:
SELECT *
FROM exercises
WHERE uuid == ?;

getExerciseByRemoteId:
SELECT *
FROM exercises
WHERE remoteId == ?;

createExercise:
INSERT INTO exercises(uuid, remoteId, nameEn, nameRu, nameUk, details, image1, image2, resultType, primaryCategoryUuid, secondaryCategoryUuids, global)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateExercise:
UPDATE exercises
SET remoteId = ?, nameEn = ?, nameRu = ?, nameUk = ?, details = ?, resultType = ?, primaryCategoryUuid = ?, secondaryCategoryUuids = ?
WHERE uuid = ?;

deleteExercise:
DELETE FROM exercises
WHERE uuid = ?;

deleteAllExercises:
DELETE FROM exercises;

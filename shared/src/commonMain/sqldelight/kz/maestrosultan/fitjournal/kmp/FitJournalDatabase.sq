import kotlin.Boolean;

------------------------- NOTES ---------------------------------

CREATE TABLE notes (
  uuid TEXT PRIMARY KEY NOT NULL,
  back4AppId TEXT DEFAULT NULL,
  userId TEXT NOT NULL,
  text TEXT NOT NULL,
  isPinned INTEGER AS Boolean NOT NULL DEFAULT 0,
  isSynced INTEGER AS Boolean NOT NULL DEFAULT 0
);

getNotes:
SELECT *
FROM notes
WHERE userId = ?;

getNoteById:
SELECT *
FROM notes
WHERE uuid = ?;

createNote:
INSERT INTO notes(uuid, back4AppId, userId, text, isPinned)
VALUES (?, ?, ?, ?, ?);

updateNote:
UPDATE notes
SET back4AppId = ?, text = ?, isPinned = ?, isSynced = ? WHERE uuid = ?;

deleteNote:
DELETE FROM notes WHERE uuid = ?;

deleteAllNotes:
DELETE FROM notes WHERE userId = ?;

------------------------------------------------------------------

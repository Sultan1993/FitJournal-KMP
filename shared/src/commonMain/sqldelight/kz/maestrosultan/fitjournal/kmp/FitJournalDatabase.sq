------------------------- NOTES ---------------------------------

CREATE TABLE notes (
  id INTEGER PRIMARY KEY NOT NULL,
  back4AppId TEXT,
  userId TEXT NOT NULL,
  text TEXT NOT NULL,
  isPinned INTEGER NOT NULL
);

getAllNotes:
SELECT *
FROM notes
WHERE userId = ?;

getPinnedNotes:
SELECT *
FROM notes
WHERE userId = ?
AND isPinned = 1;

getNoteById:
SELECT *
FROM notes
WHERE id = ?;

createNote:
INSERT INTO notes(back4AppId, userId, text, isPinned)
VALUES (?, ?, ?, ?);

updateNote:
UPDATE notes
SET back4AppId = ?, text = ?, isPinned = ? WHERE id = ?;

deleteNote:
DELETE FROM notes WHERE id = ?;

deleteAllNotes:
DELETE FROM notes;

------------------------------------------------------------------

import kotlin.Boolean;

------------------------- NOTES ---------------------------------

CREATE TABLE notes (
  uuid TEXT PRIMARY KEY NOT NULL,
  userId TEXT NOT NULL,
  text TEXT NOT NULL,
  isPinned INTEGER AS Boolean NOT NULL DEFAULT 0,
  isSynced INTEGER AS Boolean NOT NULL DEFAULT 0,
  createdAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updatedAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER update_timestamp_trigger
AFTER UPDATE ON notes
BEGIN
   UPDATE notes SET updatedAt = CURRENT_TIMESTAMP WHERE uuid = new.uuid;
END;

getNotes:
SELECT *
FROM notes
WHERE userId = ?;

getNoteById:
SELECT *
FROM notes
WHERE uuid = ?;

createNote:
INSERT INTO notes(uuid, userId, text, isPinned, isSynced)
VALUES (?, ?, ?, ?, ?);

updateNote:
UPDATE notes
SET text = ?, isPinned = ?, isSynced = ? WHERE uuid = ?;

deleteNote:
DELETE FROM notes WHERE uuid = ?;

deleteAllNotes:
DELETE FROM notes WHERE userId = ?;

------------------------------------------------------------------

CREATE TABLE photoMeasurements (
    uuid TEXT PRIMARY KEY NOT NULL,
    userId TEXT NOT NULL,
    diaryId TEXT NOT NULL,
    path TEXT NOT NULL,
    url TEXT NOT NULL,
    type TEXT NOT NULL,
    date TEXT NOT NULL,
    createdDate TEXT NOT NULL,
    updatedDate TEXT NOT NULL
);

-- `getPhotoMeasurements(userId, diaryId)` is hit every time the photo
-- measurements screen opens. Without an index it's a full table scan.
CREATE INDEX idx_photoMeasurements_diary ON photoMeasurements(userId, diaryId);

getPhotoMeasurements:
SELECT *
FROM photoMeasurements
WHERE userId = ?
AND diaryId = ?;

getPhotoMeasurementById:
SELECT *
FROM photoMeasurements
WHERE uuid = ?;

createPhotoMeasurement:
INSERT INTO photoMeasurements(uuid, userId, diaryId, path, url, type, date, createdDate, updatedDate)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deletePhotoMeasurement:
DELETE FROM photoMeasurements
WHERE uuid = ?;

deletePhotoMeasurementsByDiaryId:
DELETE FROM photoMeasurements
WHERE diaryId = ?;

deletePhotoMeasurementsByUserId:
DELETE FROM photoMeasurements
WHERE userId = ?;

deletePhotoMeasurements:
DELETE FROM photoMeasurements;
